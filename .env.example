# Copy to .env and fill in. NEVER commit .env.
# On Streamlit Cloud, put the same keys in the app's Secrets panel instead.

# Google AI Studio key (free tier). Optional at startup; AI extraction is unavailable without it.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=60

# Leave empty for local SQLite (data/invoiceflow.db).
# Hosted PostgreSQL (e.g. Supabase pooler), psycopg driver:
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:6543/postgres
DATABASE_URL=

MAX_UPLOAD_MB=10
MAX_PDF_PAGES=10

# Leave empty to auto-detect (PATH, then the default Windows install location).
TESSERACT_CMD=

LOG_LEVEL=INFO
