# Copy to .env and fill in. NEVER commit .env (it is git-ignored).
# On Streamlit Community Cloud use the app's Secrets panel instead (see .streamlit/secrets.toml.example).

# --- Google Gemini (AI extraction). Free key: https://aistudio.google.com/app/apikey ---
# Optional at startup: without it, AI extraction is reported as unavailable and manual entry is offered.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=60

# --- Database ---
# Leave empty for local SQLite (data/invoiceflow.db). For Supabase PostgreSQL use the *Transaction pooler* URI
# (port 6543), for example:
# DATABASE_URL=postgresql+psycopg://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
DATABASE_URL=

# --- Decision rules ---
# Absolute rounding tolerance for invoice arithmetic (currency units), and which invoice amount is compared with
# the PO: pre_tax (total minus tax, default) or grand_total.
AMOUNT_TOLERANCE=0.01
PO_AMOUNT_BASIS=pre_tax

# --- Limits ---
MAX_UPLOAD_MB=10
MAX_PDF_PAGES=10

# --- OCR ---
# Leave empty to auto-detect (PATH, then C:\Program Files\Tesseract-OCR\tesseract.exe on Windows).
TESSERACT_CMD=

# --- Optional: shared access code required before the app can be used (recommended for any public deployment) ---
ACCESS_CODE=

LOG_LEVEL=INFO
