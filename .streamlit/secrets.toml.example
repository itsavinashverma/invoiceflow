# TEMPLATE ONLY. Contains placeholders, never real values.
#
# Streamlit Community Cloud: paste the lines you need into  App settings -> Secrets  (TOML format).
# Local use (optional): copy this file to .streamlit/secrets.toml (git-ignored) and fill it in.
#
# Keys must be TOP-LEVEL (not inside a [section]); they are read as settings of the same name.
# Environment variables of the same name, if set, take precedence over secrets.

# --- Google Gemini (AI extraction). Create a free key in Google AI Studio. ---
GEMINI_API_KEY = "YOUR_KEY"
GEMINI_MODEL = "gemini-3.8-flash"

# --- Database. Leave unset for local SQLite. On a hosted deployment SQLite is NOT durable: use PostgreSQL. ---
# Supabase: Project -> Connect -> "Transaction pooler" (port 6543). The scheme can be postgresql:// or
# postgresql+psycopg://; the app converts it for the psycopg driver. URL-encode special characters in the password.
DATABASE_URL = "postgresql+psycopg://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-YOUR_REGION.pooler.supabase.com:6543/postgres"

# --- Optional: require a shared access code before anyone can use a public deployment. ---
# ACCESS_CODE = "choose-a-long-random-phrase"

# --- Optional tuning (defaults shown) ---
# MAX_UPLOAD_MB = 10          # also raise server.maxUploadSize in .streamlit/config.toml if you increase this
# MAX_PDF_PAGES = 10
# GEMINI_TIMEOUT_SECONDS = 60
# AMOUNT_TOLERANCE = 0.01
# PO_AMOUNT_BASIS = "pre_tax"   # or "grand_total"
